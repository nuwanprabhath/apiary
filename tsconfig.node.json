{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": { "@shared/*": ["./src/shared/*"] },
    "baseUrl": "."
  },
  "include": ["src/main", "src/shared", "tests"],
  "exclude": ["tests/e2e", "tests/component"]
}
