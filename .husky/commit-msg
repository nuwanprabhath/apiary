# Conventional Commits (feat:, fix:, chore: …), the style the history already uses.
npx --no -- commitlint --edit "$1"

# No AI attribution in commit messages (see CLAUDE.md, Releasing).
if grep -qiE '^co-authored-by:.*(claude|anthropic|openai|copilot)|generated with \[?claude' "$1"; then
  echo "commit-msg: remove the AI attribution line from the commit message." >&2
  exit 1
fi
