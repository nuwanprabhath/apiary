# The whole-repo checks, too slow to run on every commit: both tsconfigs and every linter, plus the
# native-free unit project (fast: no native modules, parallel). Integration, component and e2e stay
# out of hooks — they are slower and some drive real git/pty subprocesses.
#
# Except for a release: pushing a `v*` tag runs the whole e2e suite first, `@serial` included.
# Agents run only the specs they think their change touches, and twice a spec nobody thought of
# broke and was first seen by the nightly run after the release (1.39's Chat/Terminal toggle broke
# activeSection's @serial test; 1.40's shell bar broke the glass test in themes.spec.ts).
refs=$(cat)
# First, being the quickest to refuse: the release workflow repeats CI's checks on Linux, and a tag
# on a commit CI has not passed stops there and publishes nothing (scripts/release-ci-gate.mjs).
for sha in $(echo "$refs" | awk '$1 ~ /^refs\/tags\/v/ { print $2 }'); do
  node scripts/release-ci-gate.mjs "$(git rev-parse "$sha^{commit}")" || exit 1
done
npm run typecheck && npm run lint && npm run test:unit || exit 1
case "$refs" in
  *refs/tags/v*)
    echo "pre-push: a release tag — running the whole e2e suite (npm run test:e2e) first."
    npm run test:e2e || { echo "pre-push: e2e failed; the tag is not pushed. Fix it, then push the tag again."; exit 1; }
    ;;
esac
