{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals", "@vitest/browser-playwright", "@vitest/browser/matchers"],
    "paths": { "@shared/*": ["./src/shared/*"] },
    "baseUrl": "."
  },
  "include": ["src/renderer", "src/shared", "src/preload", "tests/e2e", "tests/component"]
}
